# ─── Dygma ────────────────────────────────────────────────────────────────────
# Serial only. Hypercolor talks to Dygma keyboards over their serial port,
# and their HID interface carries keyboard, mouse, consumer, and
# system-control input, so it gets no grant. Neither does the USB device
# node, since write access to it is enough to detach usbhid from that
# interface.
SUBSYSTEM=="tty", ATTRS{idVendor}=="35ef", MODE="0660", GROUP="users", TAG+="uaccess"

# ─── ASUS Aura ────────────────────────────────────────────────────────────────
# Scoped to the Aura USB controllers' lighting interface. ROG keyboards and
# mice share vendor ID 0b05 and expose keystroke and pointer collections as
# hidraw nodes, and motherboards hang other HID functions (USB audio
# controls) off it too. Hypercolor reaches the controllers through hidraw
# only, so they get no usb_device grant.
SUBSYSTEM=="hidraw", ATTRS{modalias}=="usb:v0B05p1867d*ic03isc*ip*in02", MODE="0660", GROUP="users", TAG+="uaccess"
SUBSYSTEM=="hidraw", ATTRS{modalias}=="usb:v0B05p1872d*ic03isc*ip*in02", MODE="0660", GROUP="users", TAG+="uaccess"
SUBSYSTEM=="hidraw", ATTRS{modalias}=="usb:v0B05p1889d*ic03isc*ip*in02", MODE="0660", GROUP="users", TAG+="uaccess"
SUBSYSTEM=="hidraw", ATTRS{modalias}=="usb:v0B05p18A3d*ic03isc*ip*in02", MODE="0660", GROUP="users", TAG+="uaccess"
SUBSYSTEM=="hidraw", ATTRS{modalias}=="usb:v0B05p18A5d*ic03isc*ip*in02", MODE="0660", GROUP="users", TAG+="uaccess"
SUBSYSTEM=="hidraw", ATTRS{modalias}=="usb:v0B05p18F3d*ic03isc*ip*in02", MODE="0660", GROUP="users", TAG+="uaccess"
SUBSYSTEM=="hidraw", ATTRS{modalias}=="usb:v0B05p1939d*ic03isc*ip*in02", MODE="0660", GROUP="users", TAG+="uaccess"
SUBSYSTEM=="hidraw", ATTRS{modalias}=="usb:v0B05p19AFd*ic03isc*ip*in02", MODE="0660", GROUP="users", TAG+="uaccess"
SUBSYSTEM=="hidraw", ATTRS{modalias}=="usb:v0B05p1AA6d*ic03isc*ip*in02", MODE="0660", GROUP="users", TAG+="uaccess"
SUBSYSTEM=="hidraw", ATTRS{modalias}=="usb:v0B05p1BEDd*ic03isc*ip*in02", MODE="0660", GROUP="users", TAG+="uaccess"

# ─── Lian Li ──────────────────────────────────────────────────────────────────
# TL Fan Hub (7372) and the L-Wireless controller's TX (8040) and RX (8041),
# scoped to the products: 0416 is Winbond's vendor ID, which unrelated HID
# hardware reports too. The wireless controller is reached through its USB
# device nodes only.
SUBSYSTEM=="hidraw", ATTRS{idVendor}=="0416", ATTRS{idProduct}=="7372", MODE="0660", GROUP="users", TAG+="uaccess"
SUBSYSTEM=="usb", ENV{DEVTYPE}=="usb_device", ATTR{idVendor}=="0416", ATTR{idProduct}=="7372", MODE="0660", GROUP="users", TAG+="uaccess"
SUBSYSTEM=="usb", ENV{DEVTYPE}=="usb_device", ATTR{idVendor}=="0416", ATTR{idProduct}=="8040", MODE="0660", GROUP="users", TAG+="uaccess"
SUBSYSTEM=="usb", ENV{DEVTYPE}=="usb_device", ATTR{idVendor}=="0416", ATTR{idProduct}=="8041", MODE="0660", GROUP="users", TAG+="uaccess"

SUBSYSTEM=="usb", ENV{DEVTYPE}=="usb_device", ATTR{idVendor}=="0cf2", MODE="0660", GROUP="users", TAG+="uaccess"

# Wired Uni Fan TL LCD panel. Scoped to the product: 04fc is a shared vendor
# ID, so a vendor-wide rule would also grab unrelated hardware.
SUBSYSTEM=="hidraw", ATTRS{idVendor}=="04fc", ATTRS{idProduct}=="7393", MODE="0660", GROUP="users", TAG+="uaccess"
SUBSYSTEM=="usb", ENV{DEVTYPE}=="usb_device", ATTR{idVendor}=="04fc", ATTR{idProduct}=="7393", MODE="0660", GROUP="users", TAG+="uaccess"

# Wireless LCD receivers (TL 0006, SL V3 0005). Scoped to the products: 1cbe
# is the Luminary Micro / TI vendor ID and covers unrelated dev boards.
SUBSYSTEM=="usb", ENV{DEVTYPE}=="usb_device", ATTR{idVendor}=="1cbe", ATTR{idProduct}=="0006", MODE="0660", GROUP="users", TAG+="uaccess"
SUBSYSTEM=="usb", ENV{DEVTYPE}=="usb_device", ATTR{idVendor}=="1cbe", ATTR{idProduct}=="0005", MODE="0660", GROUP="users", TAG+="uaccess"

# Universal Screen 8.8" in LCD mode (a088), same vendor ID, same scoping.
SUBSYSTEM=="usb", ENV{DEVTYPE}=="usb_device", ATTR{idVendor}=="1cbe", ATTR{idProduct}=="a088", MODE="0660", GROUP="users", TAG+="uaccess"


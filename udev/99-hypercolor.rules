# Peripherals: Hypercolor reaches the lighting collection through hidraw and
# never opens the USB device node, so these get no usb_device grant (write
# access to that node is enough to detach usbhid). Each product is tagged
# with its lighting interface first, then only the hidraw node on that
# interface is granted. The two steps are needed because idProduct lives on
# the USB device and bInterfaceNumber on the USB interface, and the ATTRS
# keys of one rule must all match the same parent.
#
# Bragi keyboards, mice, and mousepads: vendor-only interface 1.
SUBSYSTEM=="hidraw", ATTRS{idVendor}=="1b1c", ATTRS{idProduct}=="1ba4", ENV{HYPERCOLOR_CORSAIR_LIGHTING_IF}="01"
SUBSYSTEM=="hidraw", ATTRS{idVendor}=="1b1c", ATTRS{idProduct}=="1ba0", ENV{HYPERCOLOR_CORSAIR_LIGHTING_IF}="01"

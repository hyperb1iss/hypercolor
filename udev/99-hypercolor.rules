# Interface 3: the Huntsman V2 generation and later keyboards, the Basilisk
# V3, Krakens, and Seirens. On the Huntsman V2 and Basilisk V3 this interface
# holds one consumer collection with feature reports and no input. The
# Seiren V3 Chroma shares it with its consumer-control input (mute and
# volume), which the grant therefore exposes.
SUBSYSTEM=="hidraw", ATTRS{modalias}=="usb:v1532p0099d*ic03isc*ip*in03", MODE="0660", GROUP="users", TAG+="uaccess"

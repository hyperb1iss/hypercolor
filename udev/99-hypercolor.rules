# NXP/CUE desk accessories: interface 0. The Polaris carries a keyboard
# collection on interface 1, which stays root-only.
# MM800 RGB Polaris
SUBSYSTEM=="hidraw", ATTRS{idVendor}=="1b1c", ATTRS{idProduct}=="1b3b", ENV{HYPERCOLOR_CORSAIR_LIGHTING_IF}="00"

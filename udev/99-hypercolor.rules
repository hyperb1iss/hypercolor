# ─── QMK community implementation keyboards ───────────────────────────────────
# Scoped per product to the raw HID interface, the only one Hypercolor
# opens. QMK builds it as a non-boot HID interface with an IN and an OUT
# endpoint, while its keyboard, NKRO, mouse, and media-key interfaces have an
# IN endpoint only and stay root-only. The rules match that shape instead of
# an interface number, which shifts with the features a firmware enables.
# Older firmware gave the debug console interface an OUT endpoint as well,
# so a build with the console enabled also exposes its debug text. None of
# these gets a usb_device grant: Hypercolor never opens that node, and write
# access to it is enough to detach usbhid from the keyboard.
#
# Keychron
SUBSYSTEM=="hidraw", ATTRS{modalias}=="usb:v3434p0110d*ic03isc00ip00in*", ATTRS{bNumEndpoints}=="02", MODE="0660", GROUP="users", TAG+="uaccess"
SUBSYSTEM=="hidraw", ATTRS{modalias}=="usb:v3434p0120d*ic03isc00ip00in*", ATTRS{bNumEndpoints}=="02", MODE="0660", GROUP="users", TAG+="uaccess"
SUBSYSTEM=="hidraw", ATTRS{modalias}=="usb:v3434p0130d*ic03isc00ip00in*", ATTRS{bNumEndpoints}=="02", MODE="0660", GROUP="users", TAG+="uaccess"
SUBSYSTEM=="hidraw", ATTRS{modalias}=="usb:v3434p0150d*ic03isc00ip00in*", ATTRS{bNumEndpoints}=="02", MODE="0660", GROUP="users", TAG+="uaccess"
SUBSYSTEM=="hidraw", ATTRS{modalias}=="usb:v3434p0160d*ic03isc00ip00in*", ATTRS{bNumEndpoints}=="02", MODE="0660", GROUP="users", TAG+="uaccess"
SUBSYSTEM=="hidraw", ATTRS{modalias}=="usb:v3434p0310d*ic03isc00ip00in*", ATTRS{bNumEndpoints}=="02", MODE="0660", GROUP="users", TAG+="uaccess"

# ZSA (Moonlander, Voyager)
SUBSYSTEM=="hidraw", ATTRS{modalias}=="usb:v3297p0791d*ic03isc00ip00in*", ATTRS{bNumEndpoints}=="02", MODE="0660", GROUP="users", TAG+="uaccess"
SUBSYSTEM=="hidraw", ATTRS{modalias}=="usb:v3297p1969d*ic03isc00ip00in*", ATTRS{bNumEndpoints}=="02", MODE="0660", GROUP="users", TAG+="uaccess"

# Drop / OLKB
SUBSYSTEM=="hidraw", ATTRS{modalias}=="usb:vFEEDp6060d*ic03isc00ip00in*", ATTRS{bNumEndpoints}=="02", MODE="0660", GROUP="users", TAG+="uaccess"

# Glorious (GMMK)
SUBSYSTEM=="hidraw", ATTRS{modalias}=="usb:v320Fp5044d*ic03isc00ip00in*", ATTRS{bNumEndpoints}=="02", MODE="0660", GROUP="users", TAG+="uaccess"

# ─── Wooting ──────────────────────────────────────────────────────────────────
# Keyboards, so each rule is scoped to the configuration interface the
# lighting rides on and to nothing else. A product-wide hidraw rule would
# also open the keyboard, analog, and mouse report nodes to the fallback
# group, which exposes keystrokes, and a usb_device rule would let a group
# member detach the keyboard's input driver, so neither exists here
# (Spec 90 section 8.3). A rule exists only where a published descriptor
# dump places the configuration collection on interface 2: the Two HE (ARM)
# and the 60HE (ARM), both with gamepad emulation disabled. The modalias
# match also demands a non-boot HID interface. Every other Wooting board
# and mode gets no rule here; Wooting's own udev rules cover them.
SUBSYSTEM=="hidraw", ATTRS{modalias}=="usb:v31E3p1232d*ic03isc00ip00in02", MODE="0660", GROUP="users", TAG+="uaccess"
SUBSYSTEM=="hidraw", ATTRS{modalias}=="usb:v31E3p1312d*ic03isc00ip00in02", MODE="0660", GROUP="users", TAG+="uaccess"

# ─── Input event nodes ────────────────────────────────────────────────────────
# Host keyboard/mouse capture lives in 70-hypercolor-input.rules, which MUST
# sort before systemd's 73-seat-late.rules for `uaccess` to apply. See that
# file for the vendor list and the ordering rationale.

# ─── SMBus / I2C ──────────────────────────────────────────────────────────────
SUBSYSTEM=="i2c-dev", KERNEL=="i2c-[0-9]*", MODE="0660", GROUP="users", TAG+="uaccess"

# Thunderbolt 4 and 5 docks: the descriptor selects the lighting collection
# by usage page alone, and no descriptor dump pins its interface, so every
# HID interface of the dock's own lighting device is granted. A dock has no
# keys or pointer, and the modalias match never reaches the keyboards and
# mice plugged into it.
SUBSYSTEM=="hidraw", ATTRS{modalias}=="usb:v1532p0F21d*ic03isc*ip*in*", MODE="0660", GROUP="users", TAG+="uaccess"
SUBSYSTEM=="hidraw", ATTRS{modalias}=="usb:v1532p0F52d*ic03isc*ip*in*", MODE="0660", GROUP="users", TAG+="uaccess"

# Blade and Book laptops: the lighting report rides the mouse collection of
# interface 2, a live HID input interface, so the grant exposes its pointer
# reports. The built-in keyboard's interfaces 0 and 1 stay root-only.

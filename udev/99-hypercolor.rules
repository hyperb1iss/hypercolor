# ─── Lian Li ──────────────────────────────────────────────────────────────────
SUBSYSTEM=="hidraw", ATTRS{idVendor}=="0416", MODE="0660", GROUP="users", TAG+="uaccess"
SUBSYSTEM=="usb", ENV{DEVTYPE}=="usb_device", ATTR{idVendor}=="0416", MODE="0660", GROUP="users", TAG+="uaccess"

SUBSYSTEM=="usb", ENV{DEVTYPE}=="usb_device", ATTR{idVendor}=="0cf2", MODE="0660", GROUP="users", TAG+="uaccess"

# Wired Uni Fan TL LCD panel. Scoped to the product: 04fc is a shared vendor
# ID, so a vendor-wide rule would also grab unrelated hardware.
SUBSYSTEM=="hidraw", ATTRS{idVendor}=="04fc", ATTRS{idProduct}=="7393", MODE="0660", GROUP="users", TAG+="uaccess"
SUBSYSTEM=="usb", ENV{DEVTYPE}=="usb_device", ATTR{idVendor}=="04fc", ATTR{idProduct}=="7393", MODE="0660", GROUP="users", TAG+="uaccess"

# Wireless LCD receivers (TL 0006, SL V3 0005). Scoped to the products: 1cbe
# is the Luminary Micro / TI vendor ID and covers unrelated dev boards.
SUBSYSTEM=="usb", ENV{DEVTYPE}=="usb_device", ATTR{idVendor}=="1cbe", ATTR{idProduct}=="0006", MODE="0660", GROUP="users", TAG+="uaccess"
SUBSYSTEM=="usb", ENV{DEVTYPE}=="usb_device", ATTR{idVendor}=="1cbe", ATTR{idProduct}=="0005", MODE="0660", GROUP="users", TAG+="uaccess"

# Universal Screen 8.8" in LCD mode (a088), same vendor ID, same scoping.
SUBSYSTEM=="usb", ENV{DEVTYPE}=="usb_device", ATTR{idVendor}=="1cbe", ATTR{idProduct}=="a088", MODE="0660", GROUP="users", TAG+="uaccess"


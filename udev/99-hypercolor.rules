# Hypercolor device permissions
# Install: just udev-install
# Grants access to the physically logged-in user via systemd-logind (TAG+="uaccess").
# Some hidraw nodes can miss their ACL replay on existing devices, so we also set a
# conservative fallback group/mode for the supported vendor families.
# A replug or reboot is required after installation for existing devices.
#
# USB rules are vendor-wide for the brands Hypercolor supports so newly added
# product IDs do not require a udev update just to gain device-node access.
# SMBus access is granted generically via `/dev/i2c-*` because bus nodes are
# host-controller devices, not vendor-scoped endpoints.
#
# hidraw/tty rules use ATTRS (walk up to parent USB device for vendor match).
# usb rules use ATTR + DEVTYPE filter to match the /dev/bus/usb/ device node directly.

# ─── Razer ────────────────────────────────────────────────────────────────────
SUBSYSTEM=="hidraw", ATTRS{idVendor}=="1532", MODE="0660", GROUP="users", TAG+="uaccess"
SUBSYSTEM=="usb", ENV{DEVTYPE}=="usb_device", ATTR{idVendor}=="1532", MODE="0660", GROUP="users", TAG+="uaccess"

# ─── Corsair ──────────────────────────────────────────────────────────────────
# Scoped per product, never vendor-wide. Corsair keyboards and mice expose
# their boot-keyboard, NKRO, and pointer collections as hidraw nodes too, and
# a vendor-wide hidraw rule would hand every member of the fallback group a
# keystroke feed. ATTRS also walks up through hubs, so a vendor-wide match can
# catch any device plugged into a hub that reports Corsair's vendor ID.
#
# Fan, LCD, and Lighting Node controllers have no input collections and claim
# their HID interface directly, so they get hidraw and USB device access.
# iCUE LINK System Hub
SUBSYSTEM=="hidraw", ATTRS{idVendor}=="1b1c", ATTRS{idProduct}=="0c3f", MODE="0660", GROUP="users", TAG+="uaccess"
SUBSYSTEM=="usb", ENV{DEVTYPE}=="usb_device", ATTR{idVendor}=="1b1c", ATTR{idProduct}=="0c3f", MODE="0660", GROUP="users", TAG+="uaccess"
# Elite Capellix LCD
SUBSYSTEM=="hidraw", ATTRS{idVendor}=="1b1c", ATTRS{idProduct}=="0c39", MODE="0660", GROUP="users", TAG+="uaccess"
SUBSYSTEM=="usb", ENV{DEVTYPE}=="usb_device", ATTR{idVendor}=="1b1c", ATTR{idProduct}=="0c39", MODE="0660", GROUP="users", TAG+="uaccess"
# Elite Capellix LCD (alt)
SUBSYSTEM=="hidraw", ATTRS{idVendor}=="1b1c", ATTRS{idProduct}=="0c33", MODE="0660", GROUP="users", TAG+="uaccess"
SUBSYSTEM=="usb", ENV{DEVTYPE}=="usb_device", ATTR{idVendor}=="1b1c", ATTR{idProduct}=="0c33", MODE="0660", GROUP="users", TAG+="uaccess"
# iCUE LINK LCD
SUBSYSTEM=="hidraw", ATTRS{idVendor}=="1b1c", ATTRS{idProduct}=="0c4e", MODE="0660", GROUP="users", TAG+="uaccess"
SUBSYSTEM=="usb", ENV{DEVTYPE}=="usb_device", ATTR{idVendor}=="1b1c", ATTR{idProduct}=="0c4e", MODE="0660", GROUP="users", TAG+="uaccess"
# Nautilus RS LCD
SUBSYSTEM=="hidraw", ATTRS{idVendor}=="1b1c", ATTRS{idProduct}=="0c55", MODE="0660", GROUP="users", TAG+="uaccess"
SUBSYSTEM=="usb", ENV{DEVTYPE}=="usb_device", ATTR{idVendor}=="1b1c", ATTR{idProduct}=="0c55", MODE="0660", GROUP="users", TAG+="uaccess"
# XC7 RGB Elite LCD
SUBSYSTEM=="hidraw", ATTRS{idVendor}=="1b1c", ATTRS{idProduct}=="0c42", MODE="0660", GROUP="users", TAG+="uaccess"
SUBSYSTEM=="usb", ENV{DEVTYPE}=="usb_device", ATTR{idVendor}=="1b1c", ATTR{idProduct}=="0c42", MODE="0660", GROUP="users", TAG+="uaccess"

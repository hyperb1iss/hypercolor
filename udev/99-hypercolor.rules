# NXP/CUE keyboards and mice: interface 1, only while it has both an IN and an
# OUT endpoint. Current firmware puts the vendor-only command interface there;
# older firmware puts an IN-only keyboard interface there instead, and that
# node must stay root-only.
SUBSYSTEM=="hidraw", ATTRS{idVendor}=="1b1c", ATTRS{idProduct}=="1b3d", ENV{HYPERCOLOR_CORSAIR_LIGHTING_IF}="01-io"
SUBSYSTEM=="hidraw", ATTRS{idVendor}=="1b1c", ATTRS{idProduct}=="1b17", ENV{HYPERCOLOR_CORSAIR_LIGHTING_IF}="01-io"

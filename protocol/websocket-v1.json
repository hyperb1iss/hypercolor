        ],
        [
          "f32_le",
          "beat_confidence"
        ],
        [
          "repeated_f32_le",
          "bins"
        ]
      ]
    },
    {
      "name": "canvas",
      "tag": 3,
      "channel": "canvas",
      "layout": "preview_frame"
    },
    {
      "name": "screen_canvas",
      "tag": 5,
      "channel": "screen_canvas",
      "layout": "preview_frame"
    },
    {
      "name": "screen_zones",
      "tag": 9,
      "channel": "screen_zones",
      "layout": "screen_zones_frame"
    },
    {
      "name": "web_viewport_canvas",
      "tag": 6,
      "channel": "web_viewport_canvas",
      "layout": "preview_frame"
    },
    {
      "name": "zone_preview",
      "tag": 8,
      "channel": "zone_preview",
      "layout": "zone_preview_frame"
    },
    {
      "name": "display_preview",
      "tag": 7,
      "channel": "display_preview",
      "layout": "preview_frame"
    },
    {
      "name": "interactive_preview",
      "tag": 10,
      "channel": "interactive_preview",
      "layout": "interactive_preview_frame"
    },
    {
      "name": "wide_preview",
      "tag": 11,
      "channel": "preview_transport",
      "layout": "wide_preview_frame"
    },
    {
      "name": "wide_zone_preview",
      "tag": 12,
      "channel": "zone_preview",
      "layout": "wide_zone_preview_frame"
    },
    {
      "name": "wide_interactive_preview",
      "tag": 13,
      "channel": "interactive_preview",
      "layout": "wide_interactive_preview_frame"
    },
    {
      "name": "wide_screen_zones",
      "tag": 14,
      "channel": "screen_zones",
      "layout": "wide_screen_zones_frame"
    },
    {
      "name": "preview_chunk",
      "tag": 15,
      "channel": "preview_transport",
      "layout": "preview_chunk_frame"
    },
    {
      "name": "preview_cancel",
      "tag": 16,
      "channel": "preview_transport",
      "layout": "preview_cancel_frame"
    }
  ],
  "preview_frame": {

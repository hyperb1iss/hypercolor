{
  "schema_version": 1,
  "protocol": "hypercolor.websocket",
  "version": "1.0",
  "subprotocol": "hypercolor-v1",
  "default_subscriptions": [
    "events"
  ],
  "channels": [
    {
      "name": "frames",
      "kind": "binary",
      "default_fps": 30,
      "description": "LED color data for subscribed zones."
    },
    {
      "name": "spectrum",
      "kind": "binary",
      "default_fps": 30,
      "description": "Audio FFT spectrum and beat data."
    },
    {
      "name": "events",
      "kind": "json",
      "description": "Discrete daemon and render lifecycle events."
    },
    {
      "name": "frame_events",
      "kind": "json",
      "description": "Raw per-frame render timing events for diagnostics."
    },
    {
      "name": "canvas",
      "kind": "binary",
      "default_fps": 15,
      "description": "Composited preview canvas."
    },
    {
      "name": "screen_canvas",
      "kind": "binary",
      "default_fps": 15,
      "description": "Captured screen-source preview canvas."
    },
    {
      "name": "screen_zones",
      "kind": "binary",
      "description": "Ambilight zone grid extracted from screen capture: smoothed, color-tuned per-sector RGB colors plus letterbox state."
    },
    {
      "name": "web_viewport_canvas",
      "kind": "binary",
      "default_fps": 15,
      "description": "Browser viewport effect preview canvas."
    },
    {
      "name": "zone_preview",
      "kind": "binary",
      "default_fps": 15,
      "description": "Per-zone preview frame stream."
    },
    {
      "name": "metrics",
      "kind": "json",
      "default_interval_ms": 1000,
      "description": "Render pipeline performance metrics."
    },
    {
      "name": "device_metrics",
      "kind": "json",
      "default_interval_ms": 1000,
      "description": "Per-device output telemetry."
    },
    {
      "name": "sensors",
      "kind": "json",
      "description": "Latest host CPU, GPU, memory, and component sensor snapshot."
    },
    {
      "name": "display_preview",
      "kind": "binary",
      "default_fps": 15,
      "description": "Per-display JPEG preview frame stream."
    },
    {
      "name": "input_events",
      "kind": "json",
      "requires_control": true,
      "payload_schema": "timed_input_event_v1",
      "description": "Host input events (key and pointer edges) for automation clients. Control-authorized subscription only; never part of the default events relay."
    }
  ],
  "capabilities": [
    "frames",
    "spectrum",
    "events",
    "frame_events",
    "canvas",
    "screen_canvas",
    "screen_zones",
    "web_viewport_canvas",
    "zone_preview",
    "metrics",
    "device_metrics",
    "sensors",
    "display_preview",
    "input_events",
    "commands",
    "canvas_format_jpeg",
    "interactive_previews",
    "wide_preview_frames",
    "preview_chunking",
    "preview_transport_v1:decoded=536870912,encoded=536936448,connection=1073872896,streams=256,tombstones=1024,idle_ms=5000,message=1048576,chunks=4096"
  ],
  "preview_transport": {
    "dimension_type": "u32",
    "jpeg_max_axis": 65535,
    "passive_zero_dimension": "auto",
    "interactive_zero_dimension": "invalid",
    "min_message_bytes": 184,
    "negotiation": {
      "client_subscribe_field": "preview_transport",
      "server_subscribed_field": "preview_transport",
      "encoding": "preview_transport_v1 capability string",
      "rule": "fieldwise minimum before preview activation",
      "legacy_client_policy": "server defaults"
    },
    "max_message_bytes": 1048576,
    "max_chunk_count": 4096,
    "max_publication_decoded_bytes": 536870912,
    "max_publication_encoded_bytes": 536936448,
    "max_connection_bytes": 1073872896,
    "max_reassembly_streams": 256,
    "max_reassembly_tombstones": 1024,
    "partial_idle_ms": 5000
  },
  "json_messages": {
    "client": [
      "subscribe",
      "unsubscribe",
      "command",
      "zone_layout_preview",
      "zone_layout_preview_clear",
      "interactive_preview_open",
      "interactive_preview_close",
      "input_inject",
      "interactive_preview_claim_authoritative",
      "interactive_preview_release_authoritative"
    ],
    "server": [
      "hello",
      "subscribed",
      "unsubscribed",
      "event",
      "metrics",
      "device_metrics",
      "sensors",
      "backpressure",
      "error",
      "response",
      "interactive_preview_opened",
      "interactive_preview_closed",
      "input_injected",
      "interactive_preview_authoritative_claimed",
      "interactive_preview_authoritative_released"
    ]
  },
  "json_payloads": {
    "timed_input_event_v1": {
      "schema_version": 1,
      "channel": "input_events",
      "event": "input_event_received",
      "required_fields": [
        "event"
      ],
      "optional_fields": {
        "at_ms": 0,
        "seq": 0,
        "physical_code": null,
        "repeat_count": 1
      },
      "description": "Canonical captured input edge. Missing timing and metadata fields decode with their listed defaults for compatibility with the prior event-only payload."
    },
    "input_source_status_changed_v1": {
      "schema_version": 1,
      "channel": "events",
      "event": "input_source_status_changed",
      "required_fields": [
        "source_id",
        "kind",
        "backend",
        "configured",
        "consented",
        "demanded",
        "state",
        "freshness",
        "source_graph_generation",
        "session_generation",
        "resource_count",
        "denied_resource_count",
        "retired"
      ],
      "optional_fields": {
        "lifecycle_issue_code": null,
        "freshness_issue_code": null
      },
      "description": "Coalesced input-source lifecycle and freshness transition. Contains operational metadata only and never captured input contents."
    }
  },
  "binary_messages": [
    {
      "name": "led_frame",
      "tag": 1,
      "channel": "frames",
      "layout": [
        [
          "u8",
          "tag"
        ],
        [
          "u32_le",
          "frame_number"
        ],
        [
          "u32_le",
          "timestamp_ms"
        ],
        [
          "u8",
          "zone_count"
        ],
        [
          "repeated_zone",
          "zones"
        ]
      ]
    },
    {
      "name": "spectrum",
      "tag": 2,
      "channel": "spectrum",
      "layout": [
        [
          "u8",
          "tag"
        ],
        [
          "u32_le",
          "timestamp_ms"
        ],
        [
          "u8",
          "bin_count"
        ],
        [
          "f32_le",
          "level"
        ],
        [
          "f32_le",
          "bass"
        ],
        [
          "f32_le",

{
  "schema_version": 2,
  "protocol": "hypercolor.websocket",
  "version": "1.0",
  "subprotocol": "hypercolor-v1",
  "default_subscriptions": [
    "events"
  ],
  "topics": [
    {
      "name": "frames",
      "kind": "binary",
      "default_fps": 30,
      "description": "LED color data for subscribed zones.",
      "backpressure": "drop_with_notice"
    },
    {
      "name": "spectrum",
      "kind": "binary",
      "default_fps": 30,
      "description": "Audio FFT spectrum and beat data.",
      "backpressure": "drop_with_notice"
    },
    {
      "name": "events",
      "kind": "json",
      "description": "Discrete daemon and render lifecycle events.",
      "backpressure": "lossless"
    },
    {
      "name": "frame_events",
      "kind": "json",
      "description": "Raw per-frame render timing events for diagnostics.",
      "backpressure": "lossless"
    },
    {
      "name": "canvas",
      "kind": "binary",
      "default_fps": 15,
      "description": "Composited preview canvas.",
      "backpressure": "latest_wins"
    },
    {
      "name": "screen_canvas",
      "kind": "binary",
      "default_fps": 15,
      "description": "Captured screen-source preview canvas.",
      "requires_control": true,
      "backpressure": "latest_wins"
    },
    {
      "name": "screen_zones",
      "kind": "binary",
      "default_fps": 15,
      "description": "Ambilight zone grid extracted from screen capture: smoothed, color-tuned per-sector RGB colors plus letterbox state.",
      "requires_control": true,
      "backpressure": "latest_wins"
    },
    {
      "name": "web_viewport_canvas",
      "kind": "binary",
      "default_fps": 15,
      "description": "Browser viewport effect preview canvas.",
      "backpressure": "latest_wins"
    },
    {
      "name": "zone_preview",
      "kind": "binary",
      "default_fps": 15,
      "description": "Per-zone preview frame stream.",
      "backpressure": "latest_wins"
    },
    {
      "name": "metrics",
      "kind": "json",
      "default_fps": 1.0,
      "description": "Render pipeline performance metrics.",
      "backpressure": "drop_with_notice"
    },
    {
      "name": "device_metrics",
      "kind": "json",
      "default_fps": 1.0,
      "description": "Per-device output telemetry.",
      "backpressure": "drop_with_notice"
    },
    {
      "name": "sensors",
      "kind": "json",
      "description": "Latest host CPU, GPU, memory, and component sensor snapshot.",
      "backpressure": "latest_wins"
    },
    {
      "name": "display_preview",
      "kind": "binary",
      "default_fps": 15,
      "description": "Per-display JPEG preview frame stream, keyed by device.",
      "key": "device_id",
      "backpressure": "latest_wins"
    },
    {
      "name": "interactive_preview",
      "kind": "binary",
      "default_fps": 30,
      "description": "Interactive scene preview lane keyed by a client-chosen preview id. Subscribing opens the lane; unsubscribing closes it.",
      "requires_control": true,
      "key": "preview_id",
      "backpressure": "latest_wins"
    },
    {
      "name": "input_events",
      "kind": "json",
      "description": "Host input events (key and pointer edges) for automation clients. Control-authorized subscription only; never part of the default events relay.",
      "requires_control": true,
      "backpressure": "lossless",
      "payload_schema": "timed_input_event_v1"
    }
  ],
  "events": [
    "active_scene_changed",
    "asset_changed",
    "audio_level_update",
    "audio_source_changed",
    "audio_started",
    "audio_stopped",
    "beat_detected",
    "brightness_changed",
    "capture_started",
    "capture_stopped",
    "config_changed",
    "context_changed",
    "control_surface_changed",
    "daemon_shutdown",
    "daemon_started",
    "device_connected",
    "device_disconnected",
    "device_discovered",
    "device_discovery_completed",
    "device_discovery_started",
    "device_error",
    "device_firmware_info",
    "device_settings_changed",
    "device_state_changed",
    "effect_control_changed",
    "effect_degraded",
    "effect_error",
    "effect_registry_updated",
    "effect_started",
    "effect_stopped",
    "error",
    "extension_state_changed",
    "fps_changed",
    "frame_rendered",
    "input_event_received",
    "input_source_status_changed",
    "layer_health_changed",
    "layer_stack_changed",
    "layout_changed",
    "layout_updated",
    "layout_zone_added",
    "layout_zone_removed",
    "library_store_changed",
    "paused",
    "resumed",
    "resync_required",
    "scene_activated",
    "scene_enabled",
    "scene_library_changed",
    "scene_settings_changed",
    "scene_transition_complete",
    "scene_transition_started",
    "schedule_activated",
    "service_identity_changed",
    "session_changed",
    "shutdown_requested",
    "trigger_fired",
    "webhook_received",
    "zone_changed"
  ],
  "continuity": {
    "events_replayed_across_reconnect": false,
    "contract": "The events channel carries live changes only. A client that loses the socket misses every event during the gap, and the daemon does not replay them on reconnect. Refetch the resources you mirror after the first subscribed acknowledgment on every connection, after the event relay is live. Fold that subscription generation into your fetch epochs, and do the same on resync_required, which the daemon sends when a subscriber falls far enough behind that events were dropped on a socket that is still open.",
    "resync_signal": "resync_required"
  },
  "capabilities": [
    "frames",
    "spectrum",
    "events",
    "frame_events",
    "canvas",
    "screen_canvas",
    "screen_zones",
    "web_viewport_canvas",
    "zone_preview",
    "metrics",
    "device_metrics",
    "sensors",
    "display_preview",
    "interactive_preview",
    "input_events",
    "commands",
    "canvas_format_jpeg",
    "interactive_previews",
    "wide_preview_frames",
    "preview_chunking"
  ],
  "preview_transport": {
    "dimension_type": "u32",
    "passive_zero_dimension": "auto",
    "interactive_zero_dimension": "invalid",
    "max_publication_decoded_bytes": 536870912,
    "max_publication_encoded_bytes": 536936448,
    "max_connection_bytes": 1073872896,
    "partial_idle_ms": 5000,
    "max_message_bytes": 1048576,
    "max_reassembly_state_bytes": 8388608,
    "max_tombstone_bytes": 4194304,
    "max_sender_state_bytes": 8388608,
    "max_cursor_state_bytes": 8388608,
    "min_message_bytes": 184,
    "jpeg_max_axis": 65535
  },
  "json_messages": {
    "client": [
      "subscribe",
      "unsubscribe",
      "command",
      "zone_layout_preview",
      "zone_layout_preview_clear",
      "input_inject",
      "interactive_preview_claim_authoritative",
      "interactive_preview_release_authoritative"
    ],
    "server": [
      "hello",
      "subscribed",
      "unsubscribed",
      "input_injected",
      "interactive_preview_authoritative_claimed",
      "interactive_preview_authoritative_released",
      "event",
      "metrics",

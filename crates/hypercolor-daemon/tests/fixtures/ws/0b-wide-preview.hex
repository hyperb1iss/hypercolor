# hypercolor websocket golden fixture
# fixture: 0b-wide-preview
# tag: 0x0b (WIDE_PREVIEW_FRAME_TAG)
# encoder: hypercolor_leptos_ext::ws::PreviewFrame::try_encode
# input: canvas channel, 65536x1 rgb (wide layout)
# total-bytes: 196627
# stored-bytes: 35
# note: the remaining 196592 payload bytes are a deterministic fill and are

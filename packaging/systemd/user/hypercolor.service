[Unit]
Description=Hypercolor RGB Lighting Daemon
Documentation=https://github.com/hyperb1iss/hypercolor
After=graphical-session.target dbus.socket
Wants=graphical-session.target

[Service]
Type=notify
ExecStart=%h/.local/bin/hypercolor-daemon --ui-dir %h/.local/share/hypercolor/ui
WatchdogSec=30
Restart=on-failure
RestartSec=3
Environment=HYPERCOLOR_LOG=info
Environment=RUST_BACKTRACE=1
Environment=HYPERCOLOR_SERVICE_IDENTITY=user_service:systemd:hypercolor.service

# Resource limits
MemoryMax=512M
CPUQuota=25%

# Security hardening. systemd refuses to build the sandbox around a
# ReadWritePaths entry that does not exist, so the directories are created
# first, outside the sandbox (+), on a fresh account or after a reset.
ExecStartPre=+mkdir -p -m 0700 %h/.config/hypercolor %h/.local/share/hypercolor %h/.local/state/hypercolor
ProtectHome=read-only
ProtectSystem=strict
ReadWritePaths=%h/.config/hypercolor %h/.local/share/hypercolor %h/.local/state/hypercolor
PrivateTmp=true
NoNewPrivileges=true

[Install]
WantedBy=default.target
